{
  "name": "@tg-games/core",
  "version": "0.9.40",
  "description": "Ядро tg-games: конфигурация, движок схем, доступ к БД, провайдеры LLM и медиа, манифесты игр",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-db-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@azure/openai": "^2.0.0",
    "@google/genai": "^2.7.0",
    "@tg-games/schema-contract": "*",
    "neo4j-driver": "^6.1.0",
    "openai": "^4.67.3",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
