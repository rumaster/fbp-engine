# ===== Telegram =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ===== LLM провайдер =====
# Доступные варианты: OPENAI | GOOGLE | OPENROUTER | AZURE
LLM_PROVIDER=GOOGLE

# Ключи доступа. Для запуска обязателен ключ, соответствующий LLM_PROVIDER;
# остальные можно заполнить заранее для переключения провайдера через .env.
OPENAI_API_KEY=your_openai_key
GOOGLE_API_KEY=your_google_key
OPENROUTER_API_KEY=your_openrouter_key
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21

# Настройки активной модели.
# Для AZURE это имя deployment в Azure OpenAI.
LLM_MODEL_NAME=gemini-1.5-flash

# Карта алиасов моделей Azure (issue #120). В Azure имя deployment (алиас)
# задаётся пользователем и не совпадает с именем модели из справочника цен,
# из-за чего стоимость запроса считалась бы нулевой. Здесь сопоставляем алиас
# (deployment) канонической модели, чтобы корректно считать расход миллицентов.
# Формат: пары alias=model через запятую. Значения сидируются в таблицу
# azure_models на старте (правки прямо в БД не перезатираются).
# Пример: AZURE_MODELS=story-deployment=gpt-4o,hints-deployment=gpt-4o-mini
AZURE_MODELS=
LLM_TEMPERATURE=0.7

# Максимум попыток получить валидный JSON от LLM
LLM_MAX_RETRIES=3

# Глобальные default-модели (issue #345): раздел «Модели» в админке задаёт одно
# имя модели для всех LLM-запросов и одно имя модели для эмбеддингов. Провайдеры
# остаются в LLM_PROVIDER/EMBEDDING_PROVIDER. Бот кеширует defaults с TTL.
MODEL_DEFAULTS_CACHE_TTL_MS=30000

# ===== Кредиты =====
# Стоимость 1 Telegram Star в тысячных долях цента (миллицентах).
# 1 USD ≈ 500 Stars → 1 Star ≈ 0.2 цента = 200 миллицентов.
# Используется для подсчёта кредитного лимита на основе реальных цен LLM.
MILLICENTS_PER_STAR=200

# ===== База данных PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=tg_rpg_db

# ===== Neo4j: граф онтологии =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ===== Служба поддержки (issue #57) =====
# Токен бота поддержки для клиентов (отдельный бот от игрового).
SUPPORT_BOT_TOKEN=your_support_bot_token
# Токен бота поддержки для администраторов (ещё один отдельный бот).
SUPPORT_ADMIN_BOT_TOKEN=your_support_admin_bot_token
# Username клиентского бота без @ — для кнопки-редиректа «Служба поддержки»
# в сообщении «Помощь» игрового бота (ссылка вида https://t.me/<username>).
SUPPORT_BOT_USERNAME=your_support_bot_username
# Telegram-идентификаторы стартовых администраторов через запятую.
# Им автоматически проставляется is_admin при запуске бота администраторов.
SUPPORT_ADMIN_IDS=
# LLM-бот-консультант первой линии (issue #59): сначала «Бот СП» помогает
# клиенту и собирает детали проблемы, затем передаёт обращение администратору.
# Установите false, чтобы передавать обращения администраторам сразу.
SUPPORT_LLM_CONSULTATION=true
# Экспертиза первой линии через эмбеддинги (issue #147, #279): бот определяет проблемы
# клиента, по их эмбеддингам подтягивает справочные документы (раздел «Экспертиза»
# в админке) и подставляет их в промпт консультанта. Провайдер по умолчанию —
# OpenAI; для Azure OpenAI задайте EMBEDDING_PROVIDER=AZURE и deployment ниже.
EMBEDDING_PROVIDER=OPENAI
# Модель эмбеддингов (1536 измерений по умолчанию, совпадает с колонкой vector).
EMBEDDING_MODEL=text-embedding-3-small
# Deployment Azure OpenAI для эмбеддингов. Нужен только при EMBEDDING_PROVIDER=AZURE.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Сколько документов экспертизы максимум подтягивать в промпт за один запрос.
SUPPORT_EXPERTISE_TOP_K=3
# Экспертиза в игре (issue #154): на каждом ходе отдельная фаза 0 выделяет ключи
# ситуации и по их эмбеддингам подтягивает справочные документы базы знаний
# конкретной игры (раздел «Экспертиза» админки, привязка по игре) в промпт
# нарратива. Нужен настроенный провайдер эмбеддингов; 0 — экспертиза игры в ходе отключена.
GAME_EXPERTISE_TOP_K=2
# Долговременная память игры (issue #166): важные факты о ходе игры и состоянии
# мира хронист выделяет отдельной финальной фазой хода и сохраняет в ячейки БД
# (таблица game_memory_cells), а на каждом ходе самые важные из них подставляются
# в промпт нарратива. В отличие от экспертизы память НЕ использует эмбеддинги —
# отбор детерминированный (по важности, затем по свежести). Один рубильник:
# > 0 включает И подстановку памяти, И фазу извлечения новых фактов; 0 — отключает.
GAME_MEMORY_TOP_K=12

# ===== Web-админка (issue #114) =====
# NestJS API админ-панели слушает этот порт.
ADMIN_BACKEND_PORT=3001
# Origin Vite frontend для CORS в локальной разработке.
ADMIN_CORS_ORIGIN=http://localhost:5173
# Бот, который отправляет одноразовый код входа администратору.
# Если пусто, backend использует SUPPORT_ADMIN_BOT_TOKEN.
ADMIN_AUTH_BOT_TOKEN=
# Секрет подписи web-сессии. В production задайте длинное случайное значение.
ADMIN_SESSION_SECRET=change_me_to_long_random_secret
# Время жизни одноразового кода и web-сессии.
ADMIN_AUTH_CODE_TTL_SECONDS=600
ADMIN_AUTH_SESSION_TTL_SECONDS=28800

# ===== Медиа: озвучка, иллюстрации (issue #71) и распознавание речи (issue #118) =====
# Кнопки «Озвучить» и «Нарисовать иллюстрацию» под результатом хода, а также
# голосовой ввод: голосовое сообщение в активной игре распознаётся в текст и
# выполняется как игровое действие. Возможность необязательна: при пустом ключе
# или MEDIA_ENABLED=false она отключается, а текстовая игра работает как прежде.
#
# Провайдер медиа. По умолчанию совпадает с LLM_PROVIDER.
# Поддерживаются OPENAI и GOOGLE; OPENROUTER медиа не умеет → кнопок не будет.
MEDIA_PROVIDER=GOOGLE
# Главный выключатель медиа. false — отключить озвучку, иллюстрации и
# распознавание речи сразу.
MEDIA_ENABLED=true
# Ключ API для медиа. Если пусто — переиспользуется ключ выбранного провайдера
# (GOOGLE_API_KEY / OPENAI_API_KEY). Пустой результат полностью отключает медиа.
MEDIA_API_KEY=
# --- Озвучка (TTS) ---
MEDIA_TTS_ENABLED=true
# Модель и голос. По умолчанию: GOOGLE → gemini-2.5-flash-preview-tts / Kore;
# OPENAI → gpt-4o-mini-tts / alloy.
MEDIA_TTS_MODEL=gemini-2.5-flash-preview-tts
MEDIA_TTS_VOICE=Kore
# --- Иллюстрации ---
MEDIA_IMAGE_ENABLED=true
# Модель и размер. По умолчанию: GOOGLE → imagen-3.0-generate-002;
# OPENAI → gpt-image-1. Размер по умолчанию 1024x1024.
MEDIA_IMAGE_MODEL=imagen-3.0-generate-002
MEDIA_IMAGE_SIZE=1024x1024
# --- Распознавание речи (STT, issue #118) ---
# Голосовое сообщение в активной игре превращается в текст хода. Аудио нигде
# не сохраняется — буфер живёт только в памяти на время распознавания.
MEDIA_STT_ENABLED=true
# Модель распознавания. По умолчанию: GOOGLE → gemini-2.5-flash;
# OPENAI → whisper-1.
MEDIA_STT_MODEL=gemini-2.5-flash
